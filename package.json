{
  "name": "rommuser-studio",
  "version": "0.1.0",
  "description": "ROMMUSER Studio · chequeo de stems y portal de mezcla",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tools/libreria && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tools/libreria",
    "libreria": "node --experimental-strip-types --no-warnings tools/libreria/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelfj/studio.git"
  },
  "bugs": {
    "url": "https://github.com/axelfj/studio/issues"
  },
  "homepage": "https://github.com/axelfj/studio#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
